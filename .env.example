# Authentification agent <-> serveur
AGENT_AUTH_TOKEN=projet-monitoring-2026

# Serveur de monitoring
SERVER_HOST=0.0.0.0
SERVER_PORT=5051

# Splunk
SPLUNK_PASSWORD=changeme
SPLUNK_HEC_TOKEN=
SPLUNK_HEC_URL=https://splunk:8088/services/collector/event
SPLUNK_HEC_VERIFY_TLS=false

# Fichier d'événements utilisé par le forwarder
EVENTS_FILE=events.jsonl

command_activation_proxy="python proxy.py --listen-port 6000 --target-host 127.0.0.1 --target-port 5051 --tls-cert server.crt --tls-key server.key --target-tls"